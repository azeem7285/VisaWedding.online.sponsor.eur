  padding:15px;
  background:#eff6ff;
  border:1px solid #bfdbfe;
  border-radius:8px;
  color:#374151;
  line-height:1.6;
}

.private{
  background:#ecfdf5;
  border-color:#a7f3d0;
}

.warning{
  background:#fff7ed;
  border-color:#fed7aa;
}

.upload{
  border:1px dashed #94a3b8;
  border-radius:9px;
  padding:18px;
  margin:15px 0;
}

.upload label{
  margin-top:0;
}

.navigation{
  display:flex;
  justify-content:space-between;
  gap:12px;
  margin-top:30px;
}

button{
  border:0;
  border-radius:7px;
  padding:13px 22px;
  font-size:15px;
  font-weight:bold;
  cursor:pointer;
}

.next,.submit{
  background:#1d4ed8;
  color:#fff;
  margin-left:auto;
}

.previous{
  background:#e5e7eb;
  color:#172033;
}

